# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/geeinnovixus_dev

# NextAuth Configuration
NEXTAUTH_SECRET=<generate-a-unique-local-secret>
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=<your-local-admin-email>
ADMIN_PASSWORD=<your-private-password-at-least-12-characters>
# Optional: public Google Drive file URLs for sample Gallery records.
# SEED_GALLERY_IMAGE_URL_1=https://drive.google.com/file/d/<public-file-id>/view
# SEED_GALLERY_IMAGE_URL_2=https://drive.google.com/file/d/<another-public-file-id>/view

# Tigris S3 Configuration
TIGRIS_ENDPOINT=https://fly.storage.tigris.dev
TIGRIS_ACCESS_KEY_ID=your-access-key-id
TIGRIS_SECRET_ACCESS_KEY=your-secret-access-key
TIGRIS_BUCKET_NAME=gee-innovations-storage
TIGRIS_REGION=auto

# Firebase Configuration
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Email Configuration
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-app-password
EMAIL_FROM=noreply@geeinnovations.com

# Application Configuration
APP_NAME=Gee Innovixus
APP_URL=http://localhost:3000
# WhatsApp Configuration
WHATSAPP_NUMBER=1234567890
